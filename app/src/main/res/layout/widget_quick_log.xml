<?xml version="1.0" encoding="utf-8"?>
<!--
  RemoteViews only: the launcher inflates this in its own process, where AppCompat does
  not exist, so android:tint is the only tint available (lint's UseAppTint assumes an
  AppCompat activity). The tints are re-applied per state from the receiver anyway.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:baselineAligned="false"
    android:orientation="horizontal"
    android:padding="4dp">

    <ImageView
        android:id="@+id/widget_bottle"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginEnd="3dp"
        android:layout_weight="1"
        android:background="@drawable/widget_button_background"
        android:contentDescription="@string/cd_log_bottle"
        android:padding="7dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_bottle"
        android:tint="@color/widget_icon"
        tools:ignore="UseAppTint" />

    <ImageView
        android:id="@+id/widget_sleep"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginEnd="3dp"
        android:layout_weight="1"
        android:background="@drawable/widget_button_background"
        android:contentDescription="@string/cd_log_sleep"
        android:padding="7dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_sleep"
        android:tint="@color/widget_icon"
        tools:ignore="UseAppTint" />

    <ImageView
        android:id="@+id/widget_diaper"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="@drawable/widget_button_background"
        android:contentDescription="@string/cd_log_diaper"
        android:padding="7dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_diaper"
        android:tint="@color/widget_icon"
        tools:ignore="UseAppTint" />

</LinearLayout>
